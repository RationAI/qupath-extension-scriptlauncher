{
    "$schema": "https://gitlab.com/empaia/integration/definitions/-/raw/main/ead/ead-schema.v3.json",
    "name": "PD-L1 Score Estimate",
    "name_short": "PDL1Est",
    "namespace": "org.empaia.rationai.qupath_pdl1_tps_01.v3.0",
    "description": "Estimates the PD-L1 Tumor Proportion Score inside a drawn region of a PD-L1 IHC slide, using the IGNITE PD-L1 cell detection model (trained on NSCLC, weights CC BY-NC-SA 4.0). Use on PD-L1 IHC only. Not a clinical TPS.",
    "classes": {},
    "configuration": {
        "global": {
            "script": { "type": "string" },
            "conf_threshold": { "type": "float" },
            "iou_threshold": { "type": "float" }
        }
    },
    "io": {
        "my_wsi": { "type": "wsi" },
        "script": { "type": "string" },
        "input_roi": {
            "type": "rectangle",
            "reference": "io.my_wsi"
        },
        "conf_threshold": { "type": "float" },
        "iou_threshold": { "type": "float" },
        "positive_tumor_cells": {
            "type": "collection",
            "items": {
                "type": "polygon",
                "reference": "io.my_wsi"
            }
        },
        "negative_tumor_cells": {
            "type": "collection",
            "items": {
                "type": "polygon",
                "reference": "io.my_wsi"
            }
        },
        "non_tumor_cells": {
            "type": "collection",
            "items": {
                "type": "polygon",
                "reference": "io.my_wsi"
            }
        },
        "score_percent": {
            "type": "collection",
            "items": { "type": "float" }
        },
        "positive_count": {
            "type": "collection",
            "items": { "type": "float" }
        },
        "tumor_count": {
            "type": "collection",
            "items": { "type": "float" }
        },
        "non_tumor_count": {
            "type": "collection",
            "items": { "type": "float" }
        }
    },
    "modes": {
        "standalone": {
            "inputs": [
                "my_wsi",
                "script",
                "input_roi",
                "conf_threshold",
                "iou_threshold"
            ],
            "outputs": [
                "positive_tumor_cells",
                "negative_tumor_cells",
                "non_tumor_cells",
                "score_percent",
                "positive_count",
                "tumor_count",
                "non_tumor_count"
            ]
        }
    }
}
